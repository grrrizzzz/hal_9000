        "textMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Regression runs",
      "description": "",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "kb-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "kb-sqlite"
          },
          "queryText": "SELECT r.at AS time, COALESCE(p.name, '') AS profile, r.trigger,\n       r.recall_2k AS recall, r.recall_low AS low, r.recall_high AS high,\n       r.n_questions AS questions\nFROM regression_runs AS r LEFT JOIN profiles AS p ON p.id = r.profile_id\nORDER BY r.at DESC, r.id DESC LIMIT 50",
          "rawQueryText": "SELECT r.at AS time, COALESCE(p.name, '') AS profile, r.trigger,\n       r.recall_2k AS recall, r.recall_low AS low, r.recall_high AS high,\n       r.n_questions AS questions\nFROM regression_runs AS r LEFT JOIN profiles AS p ON p.id = r.profile_id\nORDER BY r.at DESC, r.id DESC LIMIT 50",
          "queryType": "table",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(recall|low|high)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Latest sweep metrics by profile",
      "description": "The latest finished evaluation run per profile (plan \u00a78). Metrics keyed by a budget read name@tokens.",
      "datasource": {
        "type": "prometheus",
        "uid": "kb-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kb-prometheus"
          },
          "expr": "kb_eval_metric",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "metric",
            "rowField": "profile",
            "valueField": "Value"
          }
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Evaluation runs",
      "description": "",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "kb-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "kb-sqlite"
          },
          "queryText": "SELECT started_at AS time, id, stage, split, host,\n       ROUND(cost_usd, 4) AS cost_usd, finished_at\nFROM eval_runs\nORDER BY started_at DESC LIMIT 50",
          "rawQueryText": "SELECT started_at AS time, id, stage, split, host,\n       ROUND(cost_usd, 4) AS cost_usd, finished_at\nFROM eval_runs\nORDER BY started_at DESC LIMIT 50",
          "queryType": "table",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
