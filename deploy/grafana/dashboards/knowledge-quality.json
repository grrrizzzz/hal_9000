        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Latest regression recall @ 2k",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "kb-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kb-prometheus"
          },
          "expr": "kb_regression_recall",
          "legendFormat": "recall",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
