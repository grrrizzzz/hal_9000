  "panels": [
    {
      "type": "timeseries",
      "title": "Post-ingest regression recall @ 2k",
      "description": "The latest regression run on the approved question set. Alert: down more than 5 points after an ingestion.",
      "datasource": {
        "type": "prometheus",
        "uid": "kb-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kb-prometheus"
          },
          "expr": "kb_regression_recall",
          "legendFormat": "recall @ 2k",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": false
          },
          "min": 0,
          "max": 1
