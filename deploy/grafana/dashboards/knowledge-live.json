    {
      "type": "timeseries",
      "title": "Retrieval latency p50 by stage",
      "description": "Per-stage quantiles, stacked: the query embedding plus local retrieval (vector, bm25, fuse, rerank, select).",
      "datasource": {
        "type": "prometheus",
        "uid": "kb-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kb-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, stage) (rate(kb_stage_seconds_bucket{stage=~\"embed_query|vector|bm25|fuse|rerank|select\"}[$__rate_interval])))",
          "legendFormat": "{{stage}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
