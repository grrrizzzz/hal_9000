    {
      "type": "timeseries",
      "title": "Cost per question (hourly average)",
      "description": "From the traces table: the metered spend recorded on each question's trace.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "kb-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "kb-sqlite"
          },
          "queryText": "SELECT (CAST(strftime('%s', created_at) AS INTEGER) / 3600) * 3600 AS time,\n       AVG(cost_usd) AS cost_per_question\nFROM traces\nWHERE kind = 'question' AND julianday(created_at) BETWEEN julianday($__from / 1000.0, 'unixepoch') AND julianday($__to / 1000.0, 'unixepoch')\nGROUP BY 1 ORDER BY 1",
          "rawQueryText": "SELECT (CAST(strftime('%s', created_at) AS INTEGER) / 3600) * 3600 AS time,\n       AVG(cost_usd) AS cost_per_question\nFROM traces\nWHERE kind = 'question' AND julianday(created_at) BETWEEN julianday($__from / 1000.0, 'unixepoch') AND julianday($__to / 1000.0, 'unixepoch')\nGROUP BY 1 ORDER BY 1",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": false
