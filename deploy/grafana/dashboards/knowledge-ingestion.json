        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "kb-prometheus"
          },
          "expr": "sum(increase(kb_ingest_pages_total{text_layer=\"yes\"}[1d]))",
          "legendFormat": "with text layer",
          "instant": false,
          "range": true
