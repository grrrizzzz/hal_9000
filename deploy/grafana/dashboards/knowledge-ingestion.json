      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Parse and embed time per page",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "kb-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kb-prometheus"
          },
          "expr": "sum(rate(kb_stage_seconds_sum{stage=\"parse\"}[1h])) / sum(rate(kb_ingest_pages_total[1h]))",
          "legendFormat": "parse s/page",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "kb-prometheus"
          },
          "expr": "sum(rate(kb_stage_seconds_sum{stage=\"embed\"}[1h])) / sum(rate(kb_ingest_pages_total[1h]))",
          "legendFormat": "embed s/page",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": false
