    {
      "type": "table",
      "title": "Failed jobs",
      "description": "The latest 50 failed ingest, reindex and regression jobs.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "kb-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "kb-sqlite"
          },
          "queryText": "SELECT updated_at AS time, kind, substr(COALESCE(file_sha, ''), 1, 12) AS file,\n       error\nFROM jobs\nWHERE status = 'failed'\nORDER BY updated_at DESC LIMIT 50",
          "rawQueryText": "SELECT updated_at AS time, kind, substr(COALESCE(file_sha, ''), 1, 12) AS file,\n       error\nFROM jobs\nWHERE status = 'failed'\nORDER BY updated_at DESC LIMIT 50",
          "queryType": "table",
          "timeColumns": [
            "time"
          ]
        }
