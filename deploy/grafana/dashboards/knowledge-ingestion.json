{
  "uid": "kb-ingestion",
  "title": "Knowledge: Ingestion",
  "description": "Uploads, parsing, embedding and the size of the index (plan \u00a79.3).",
  "tags": [
    "hal9000",
    "knowledge"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Knowledge dashboards",
      "type": "dashboards",
      "tags": [
        "knowledge"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Files by status (per day)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "kb-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kb-prometheus"
          },
          "expr": "sum by (status) (increase(kb_ingest_files_total[1d]))",
          "legendFormat": "{{status}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Pages without a text layer (per day)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "kb-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kb-prometheus"
          },
          "expr": "sum(increase(kb_ingest_pages_total{text_layer=\"no\"}[1d]))",
