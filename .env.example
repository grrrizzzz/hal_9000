# HAL 9000 configuration.
#
#   cp .env.example .env      # .env is git-ignored; secrets live only there
#
# `hal9000` loads .env from the folder you run it in (or any parent).
# Every line below that is commented out shows its default.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Without a key, runs still work: HAL sends the deterministic template report
# and marks the run "degraded". `--no-llm` does the same on purpose.
OPENAI_API_KEY=
# LLM_PROVIDER=openai                 # openai | anthropic (OpenAI is tried first)

# Models per tier (any LiteLLM model string). The solar agent uses fast,
# the triage sub-agent uses powerful.
# AGENT_MODEL_FAST=openai/gpt-5-mini
# AGENT_MODEL_POWERFUL=openai/gpt-5
# AGENT_REASONING_FAST=low
# AGENT_REASONING_POWERFUL=medium
# AGENT_MAX_TOKENS=                   # default 8192 fast / 16384 powerful (reasoning counts)
# AGENT_MAX_ITERATIONS=12

# ---------------------------------------------------------------------------
# Home Assistant
# ---------------------------------------------------------------------------
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=                             # Profile -> Security -> Long-lived access tokens

# Emporia Vue energy entities (daily-resetting kWh with long-term statistics).
# Note Emporia's names are inverted: "mainstogrid" is IMPORT, "mainsfromgrid" is EXPORT.
# HA_ENTITY_SOLAR=sensor.electron_inspector_energy_today_13
# HA_ENTITY_GRID_IMPORT=sensor.mainstogrid_energy_today
# HA_ENTITY_GRID_EXPORT=sensor.mainsfromgrid_energy_today

# Where the evening report is spoken. Change this one line to move it,
# or pass --speaker media_player.xyz for a single run.
# HA_ENTITY_SPEAKER=media_player.unnamed_room_4
# HA_TTS_ENTITY=tts.home_assistant_cloud   # or tts.google_translate_en_com

# The Emporia solar channel read half until its multiplier was fixed.
# Statistics before SOLAR_FIXED_AT are multiplied by SOLAR_SCALE.
# SOLAR_FIXED_AT must be ISO 8601 with a UTC offset.
SOLAR_SCALE=2.0
SOLAR_FIXED_AT=2026-09-27T18:35:00-07:00

# ---------------------------------------------------------------------------
# Telegram (optional: without it, alerts print to the console)
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_TEST_CHAT_ID=              # dry runs go here; if unset they go to the main
#                                     # chat prefixed [DRY RUN]

# ---------------------------------------------------------------------------
# HAL runtime
# ---------------------------------------------------------------------------
# HAL_TIMEZONE=America/Los_Angeles
# HAL_DATA_DIR=./data                 # SQLite history, transcripts, health.json
# HAL_CONFIG_DIR=./config             # site.yaml, thresholds.yaml, tariff.yaml
# HAL_RUN_SOFT_CAP_USD=0.25           # agent is told to wrap up
# HAL_RUN_HARD_CAP_USD=1.00           # agent is stopped; template report sent
# HAL_MONTHLY_CAP_USD=10.0            # triage off at 80%, agent off at 100%
# HAL_API_TOKEN=                      # bearer token for `hal9000 serve` (n8n later)
# DEADMAN_PING_URL=                   # e.g. a healthchecks.io URL, pinged after each run

# Feature switches (1 = on)
# AGENT_ENABLE_SHADOW_MODE=0          # same as --shadow on every run
# AGENT_ENABLE_TRIAGE_ENABLED=1
# AGENT_ENABLE_VERBOSE_LOGGING=0
