# hello-agent configuration.
#
#   cp .env.example .env
#
# Supply ONE provider key and you are running. Everything below that is optional
# and shown with its default.

# ---------------------------------------------------------------------------
# 1. Provider -- pick one
# ---------------------------------------------------------------------------

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Force a provider when both keys are present. Unset, the agent uses
# ANTHROPIC_API_KEY if it is set, otherwise OPENAI_API_KEY.
# LLM_PROVIDER=anthropic          # anthropic | openai

# ---------------------------------------------------------------------------
# 2. Model tiers (MATE: model efficiency)
# ---------------------------------------------------------------------------
# Cheap mechanical work runs on the fast tier, judgement on the powerful tier.
# Defaults: anthropic/claude-opus-5 + anthropic/claude-haiku-4-5
#           openai/gpt-4o          + openai/gpt-4o-mini
# Set either of these to any LiteLLM model string to override the table.

# AGENT_MODEL_POWERFUL=anthropic/claude-opus-5
# AGENT_MODEL_FAST=anthropic/claude-haiku-4-5

# ---------------------------------------------------------------------------
# 3. Runtime limits and paths
# ---------------------------------------------------------------------------

# AGENT_MAX_TOKENS=1024            # output tokens per LLM call
# AGENT_MAX_ITERATIONS=10          # agent loop iteration ceiling
# AGENT_MAX_DURATION_SECONDS=180   # agent loop wall-clock ceiling
# AGENT_GUESTBOOK_PATH=guestbook.json
# AGENT_TIMEZONE=America/Chicago   # used by the time_aware capability

# ---------------------------------------------------------------------------
# 4. Feature flags -- all off by default
# ---------------------------------------------------------------------------
# The default run is deliberately lean: five tools, no capabilities. Set any of
# these to 1 to switch on a pattern that already ships complete and tested.

# AGENT_ENABLE_TIME_AWARE=1         # TimeAwareCapability: current time in every prompt
# AGENT_ENABLE_PLAN_FIRST=1         # PlanFirstCapability: plan before acting
# AGENT_ENABLE_PROGRESS_TRACKING=1  # ProgressTrackingCapability: periodic progress reports
# AGENT_ENABLE_VERBOSE_LOGGING=1    # LoggingCapability: structured trace of the loop
# AGENT_ENABLE_DELEGATION=1         # translator sub-agent + call_agent tools
# AGENT_ENABLE_STAGED_REVIEW=1      # StagedActionEnvironment: review writes before they land
# AGENT_ENABLE_DYNAMIC_EXPERTS=1    # create_and_consult_expert
